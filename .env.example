# 复制本文件为 .env.local 并填入实际值

# NextAuth.js v4
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret-min-32-chars

# GitHub OAuth App（可选；未配置时可使用 AUTH_PASSWORD 或本地开发登录）
GITHUB_ID=your-github-oauth-app-id
GITHUB_SECRET=your-github-oauth-app-secret

# 单人部署访问口令（可选；未配置 GitHub 时推荐设置，生产模式下防止他人免密进入）
# AUTH_PASSWORD=your-secure-access-password
# 若生产环境未配置 GitHub 且未设置 AUTH_PASSWORD，系统默认禁用免密登录；如确需临时开放可设置：
# ALLOW_INSECURE_DEV_LOGIN=false

# SQLite
DATABASE_URL=./data/resumer.db

# Puppeteer (macOS local development)
PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# AI 模型（AI 共创与改写共用；只放服务端，不要写进浏览器）。详见 docs/ai-config.md
# 默认 DeepSeek：
DEEPSEEK_API_KEY=your-deepseek-api-key
# 可选，默认 deepseek-v4-flash
# DEEPSEEK_MODEL=deepseek-v4-flash

# 改用其他提供方（可选）：
# AI_PROVIDER=openai
# AI_MODEL=gpt-5-mini
# OPENAI_API_KEY=your-openai-api-key
# 或用通用 Key，优先于各家的 Key 变量：
# AI_API_KEY=
# AI_BASE_URL=
# 本地演示（不联网、不需要 Key）：AI_PROVIDER=mock
